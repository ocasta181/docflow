builds_dir := "/Users/ocasta/Code/utils/builds"

# Build standalone executable
build:
    source .venv/bin/activate && \
    pyinstaller --onefile \
        --name jpg2pdf \
        --distpath {{builds_dir}} \
        --workpath /tmp/jpg2pdf_build \
        --specpath /tmp \
        jpg2pdf.py

# Install dev dependencies
setup:
    uv venv
    source .venv/bin/activate && uv pip install -e ".[dev]"

# Clean build artifacts
clean:
    rm -rf build dist *.spec __pycache__
    rm -rf /tmp/jpg2pdf_build
