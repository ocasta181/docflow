builds_dir := "/Users/ocasta/Code/utils/builds"
tesseract_bin := "/opt/homebrew/bin/tesseract"
tessdata_dir := "/opt/homebrew/share/tessdata"

# Build standalone executable with bundled tesseract
build:
    source .venv/bin/activate && \
    pyinstaller --onefile \
        --name batch-ocr \
        --distpath {{builds_dir}} \
        --workpath /tmp/batch-ocr_build \
        --specpath /tmp \
        --add-binary "{{tesseract_bin}}:." \
        --add-data "{{tessdata_dir}}/eng.traineddata:tessdata" \
        --add-data "{{tessdata_dir}}/osd.traineddata:tessdata" \
        main.py

# Install dev dependencies
setup:
    uv venv
    source .venv/bin/activate && uv pip install -e ".[dev]"

# Run tests
test:
    source .venv/bin/activate && pytest tests/ -v

# Clean build artifacts
clean:
    rm -rf build dist *.spec __pycache__ .pytest_cache
    rm -rf /tmp/batch-ocr_build
